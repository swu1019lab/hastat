# Start from an empty source payload instead of setuptools' automatic defaults.
global-exclude *
include pyproject.toml setup.py MANIFEST.in README.md CHANGELOG.md LICENSE
include hastat.egg-info/PKG-INFO hastat.egg-info/SOURCES.txt
include hastat.egg-info/dependency_links.txt hastat.egg-info/entry_points.txt
include hastat.egg-info/requires.txt hastat.egg-info/top_level.txt
include docs/EXAMPLES.md
include docs/gallery.html
recursive-include docs/examples *.csv *.gff3 *.toml *.vcf commands.sh
include docs/examples/gene.vcf.gz docs/examples/gene.vcf.gz.tbi
recursive-include docs/images *.png *.pdf *.svg
recursive-include hastat *.py
recursive-include hastat/conf *.toml *.mplstyle
prune tests
prune dev
prune archive
prune qa
prune dist
prune build
global-exclude __pycache__ *.py[cod] test_*.py *_test.py conftest.py validate*.py
